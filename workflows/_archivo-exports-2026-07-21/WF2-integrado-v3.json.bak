      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  nombre:        body.nombre     || '',\n  email:         body.email      || '',\n  email_usuario: body.email      || '',\n  perfil:        body.perfil     || '',\n  rol:           body.rol        || '',\n  stack:         body.stack      || [],\n  salario:       body.salario    || 0,\n  modalidad:     body.modalidad  || [],\n  ciudad:        body.ciudad     || '',\n  linkedin:      body.linkedin   || '',\n  cv_master_url: body.cv_master_url || '',\n  user_id:    body.user_id || '',\n    source:        body.source     || 'interno'\n}}];"
      },
