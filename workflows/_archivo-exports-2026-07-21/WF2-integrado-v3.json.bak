    {
      "parameters": {
        "url": "https://remotive.com/api/remote-jobs?category=software-dev",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        380,
        460
      ],
      "id": "search-remotive-0001",
      "name": "Buscar en Remotive",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "=https://api.adzuna.com/v1/api/jobs/es/search/1?app_id=524625d0&app_key={{ $env.ADZUNA_APP_KEY }}&results_per_page=30&what_or={{ encodeURIComponent(($('Loop Over Users').item.json.rol || '') + ' ' + (($('Loop Over Users').item.json.stack || []).join(' '))) }}&where={{ encodeURIComponent($('Loop Over Users').item.json.ciudad || 'Madrid') }}&max_days_old=14&content-type=application/json",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        460
      ],
      "id": "search-adzuna-0001",
      "name": "Buscar en Adzuna",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "https://www.tecnoempleo.com/alertas-empleo-rss.php",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        460
      ],
      "id": "search-tecno-0001",
      "name": "Buscar en Tecnoempleo",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Junta 3 fuentes + filtra por el stack del usuario actual (multi-usuario).\nconst U = $('Loop Over Users').item.json;\nconst LT = String.fromCharCode(60);\nconst GT = String.fromCharCode(62);\nconst tagRe = new RegExp(LT + '[^' + GT + ']*' + GT, 'g');\nconst limpiar = (s) => (s || '').replace(tagRe, ' ').split('&nbsp;').join(' ').replace(/\\s+/g, ' ').trim();\n\n// Keywords base (dev) + stack/rol del usuario\nconst BASE = ['developer','desarrollador','frontend','front-end','fullstack','full stack','full-stack','software engineer','ingeniero de software','tech lead','web developer'];\nconst userStack = (U.stack || []).map(s => String(s).toLowerCase());\nconst userRol = String(U.rol || '').toLowerCase().split(/\\s+/).filter(Boolean);\nconst KEYWORDS = [...new Set([...BASE, ...userStack, ...userRol])];\nconst EXCLUIR = ['dba','sql server','administrador de sistemas','sysadmin','linux rhel','redshift','oracle dba','soporte','helpdesk','help desk','comercial','ventas','sales','contable','contabilidad','recruiter','reclutador','qa manual','tester manual','becario','prácticas','beca'];\n\nconst matchea = (titulo, desc) => {\n  const tit = (titulo || '').toLowerCase();\n  const todo = (titulo + ' ' + desc).toLowerCase();\n  if (EXCLUIR.some(k => tit.includes(k))) return false;\n  return KEYWORDS.some(k => k && todo.includes(k));\n};\n\nconst out = [];\n\n// Remotive\ntry {\n  const jobs = $('Buscar en Remotive').first().json.jobs || [];\n  for (const j of jobs.slice(0, 25)) {\n    const desc = limpiar(j.description).slice(0, 130);\n    if (!matchea(j.title, limpiar(j.description))) continue;\n    out.push('[Remotive] ' + j.title + ' | ' + j.company_name + ' | ' + (j.candidate_required_location || 'Remoto') + ' | ' + (j.salary || 's/i') + ' | ' + j.url + ' | ' + desc);\n  }\n} catch (e) {}\n\n// Adzuna\ntry {\n  const results = ($('Buscar en Adzuna').first().json.results || []).slice(0, 25);\n  for (const j of results) {\n    const descFull = limpiar(j.description);\n    if (!matchea(j.title, descFull)) continue;\n    const sal = j.salary_min ? Math.round(j.salary_min) + '-' + Math.round(j.salary_max || j.salary_min) : 's/i';\n    out.push('[Adzuna] ' + j.title + ' | ' + ((j.company||{}).display_name||'') + ' | ' + ((j.location||{}).display_name||'') + ' | ' + sal + ' | ' + j.redirect_url + ' | ' + descFull.slice(0,130));\n  }\n} catch (e) {}\n\n// Tecnoempleo (RSS XML)\ntry {\n  const xml = $('Buscar en Tecnoempleo').first().json.data || $('Buscar en Tecnoempleo').first().json.body || '';\n  const parts = xml.split('<item>');\n  const slice = (s, a, b) => { const i = s.indexOf(a); if (i<0) return ''; const j = s.indexOf(b, i+a.length); return j<0 ? '' : s.substring(i+a.length, j); };\n  const cdata = (s) => s.split('<![CDATA[').join('').split(']]>').join('').trim();\n  for (let k = 1; k < parts.length && k <= 30; k++) {\n    const it = parts[k];\n    const title = cdata(slice(it, '<title>', '</title>'));\n    const link = cdata(slice(it, '<link>', '</link>'));\n    const descFull = limpiar(cdata(slice(it, '<description>', '</description>')));\n    if (!matchea(title, descFull)) continue;\n    out.push('[Tecnoempleo] ' + title + ' | | España | s/i | ' + link + ' | ' + descFull.slice(0,130));\n  }\n} catch (e) {}\n\nconst lista = out.length\n  ? out.map((l, i) => '#' + (i+1) + ' ' + l).join('\\n\\n')\n  : 'NO se encontraron ofertas que coincidan con el perfil del usuario hoy.';\n\n// Arrastra el contexto del usuario para Groq y para crear la oferta\nreturn [{ json: {\n  ofertas:       lista,\n  total:         out.length,\n  email_usuario: U.email_usuario || U.email || '',\n  nombre:        U.nombre || '',\n  perfil:        U.perfil || '',\n  rol:           U.rol || '',\n  stack:         U.stack || [],\n  salario:       U.salario || 0,\n  modalidad:     U.modalidad || [],\n  ciudad:        U.ciudad || '',\n  cv_master_url: U.cv_master_url || '',\n  user_id:       U.user_id || ''\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        460
      ],
      "id": "search-formatear-0001",
      "name": "Formatear ofertas",
      "onError": "continueRegularOutput"
    }
  ],
