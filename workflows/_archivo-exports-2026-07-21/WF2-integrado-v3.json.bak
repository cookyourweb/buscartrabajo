        "body": "={{ JSON.stringify({\n  sender: {name: 'N8N Error Monitor', email: 'veronica@usecookyourwebai.es'},\n  to: [{email: $json.to}],\n  subject: $json.subject,\n  htmlContent: $json.htmlContent\n}) }}",
