    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"llama-3.3-70b-versatile\",\n  messages: [{\n    role: \"user\",\n    content: \"Eres un experto en redacción de cartas de presentación para ofertas de trabajo en España. Escribe una carta de presentación profesional en español.\\\\n\\\\nDATOS DE LA OFERTA:\\\\n- Empresa: \" + ($('Notion - Obtener Datos Oferta').first().json.properties?.Empresa?.title?.[0]?.text?.content || '') + \"\\\\n- Puesto: \" + ($('Notion - Obtener Datos Oferta').first().json.properties?.Puesto?.rich_text?.[0]?.text?.content || '') + \"\\\\n- Descripción: \" + ($('Notion - Obtener Datos Oferta').first().json.properties?.Notas?.rich_text?.[0]?.text?.content || '') + \"\\\\n\\\\nINSTRUCCIONES:\\\\n- Carta de máximo 300 palabras\\\\n- Tono profesional pero cercano\\\\n- Destacar experiencia en React, TypeScript, Vue.js\\\\n- Formato: Estimados/as, ..., Atentamente, Verónica Serna\\\\n- Devuelve SOLO el texto de la carta\"\n  }],\n  max_tokens: 1024,\n  temperature: 0.7\n}) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        624
      ],
      "id": "975a4cd6-8564-4fac-83bb-0c27669bc02e",
      "name": "Groq - Generar Carta",
      "retryOnFail": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cv-server-ggd8.onrender.com/generar-cv",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  email:       $('Notion - Obtener Datos Oferta').first().json.properties['Email usuario']?.rich_text?.[0]?.plain_text \n               || $('Notion - Obtener Datos Oferta').first().json.properties['Email usuario']?.email \n               || 'hello.cookyourweb@gmail.com',\n  empresa:     $('Notion - Obtener Datos Oferta').first().json.properties.Empresa?.title?.[0]?.text?.content || '',\n  puesto:      $('Notion - Obtener Datos Oferta').first().json.properties.Puesto?.rich_text?.[0]?.text?.content || '',\n  descripcion: $('Notion - Obtener Datos Oferta').first().json.properties.Notas?.rich_text?.[0]?.text?.content || ''\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        720
      ],
      "id": "dba680e7-6aac-4847-aa06-58f3ffd750e1",
      "name": "CV Server - Generar CV",
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const notionData = $('Notion - Obtener Datos Oferta').first().json;\nconsole.log('NOTION PROPS:', JSON.stringify(Object.keys(notionData.properties || {})));\nconsole.log('EMAIL USUARIO raw:', JSON.stringify(notionData.properties?.['Email usuario']));\nconst empresa = notionData.properties?.Empresa?.title?.[0]?.text?.content || '';\nconst puesto = notionData.properties?.Puesto?.rich_text?.[0]?.text?.content || '';\nconst pageId = notionData.id || '';\nconst nombreContacto = notionData.properties?.['Nombre Contacto']?.rich_text?.[0]?.text?.content || '';\nconst emailContacto = notionData.properties?.['Email empresa']?.email || '';\nconst telefonoContacto = notionData.properties?.['Teléfono Contacto']?.phone_number || '';\n\nconst cartaText = $('Groq - Generar Carta').first().json.choices?.[0]?.message?.content || '';\n\nlet linkCV = '';\ntry {\n  linkCV = $('CV Server - Generar CV').first().json.link || null;\n} catch(e) {\n  console.log('⚠️ CV Server no disponible:', e.message);\n}\n\nconst emailDestino = notionData.properties?.['Email usuario']?.rich_text?.[0]?.plain_text \n  || notionData.properties?.['Email usuario']?.email \n  || 'hello.cookyourweb@gmail.com';\n\nconst htmlContent = '<div style=\"font-family:Arial;padding:20px;max-width:600px\">'\n  + '<h2 style=\"color:#1F5C8B\">Carta de presentación</h2>'\n  + '<h3>' + empresa + ' — ' + puesto + '</h3>'\n  + '<div style=\"padding:16px;line-height:1.6;white-space:pre-wrap;background:#f9f9f9;border-radius:6px\">' + cartaText + '</div>'\n  + (linkCV ? '<br><br><a href=\"' + linkCV + '\" style=\"background:#1F5C8B;color:white;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block\">📄 Ver CV en Drive</a>' : '<p style=\"color:#EF4444\">⚠️ CV no generado</p>')\n  + '<br><br><a href=\"https://n8n-st1v.onrender.com/webhook/@@SECRET:Webhook Mandar Empresa?id=' + pageId + '\" style=\"background:#22C55E;color:white;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;font-weight:bold\">✅ Confirmar envío a empresa</a>'\n  + '</div>';\n\nreturn [{\n  json: {\n    empresa, puesto, pageId, cartaText, linkCV, nombreContacto, emailContacto, telefonoContacto,\n    notionPageId: pageId,\n    notionLinkCV: linkCV || null,\n    cartaEnviada: cartaText,\n    emailDestino,\n    htmlContent,\n    brevoBody_old: JSON.stringify({\n      sender: {name: 'Verónica Serna', email: 'veronica@usecookyourwebai.es'},\n      to: [{email: notionData.properties?.['Email usuario']?.rich_text?.[0]?.plain_text || notionData.properties?.['Email usuario']?.email || 'hello.cookyourweb@gmail.com'}],\n      subject: '📝 Carta y CV — ' + empresa + ' — ' + puesto,\n      htmlContent: '<div style=\"font-family:Arial;padding:20px;max-width:600px\">'\n        + '<h2 style=\"color:#1F5C8B\">Carta de presentación</h2>'\n        + '<h3>' + empresa + ' — ' + puesto + '</h3>'\n        + '<div style=\"padding:16px;line-height:1.6;white-space:pre-wrap;background:#f9f9f9;border-radius:6px\">' + cartaText + '</div>'\n        + (linkCV ? '<br><br><a href=\"' + linkCV + '\" style=\"background:#1F5C8B;color:white;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block\">📄 Ver CV en Drive</a>' : '<p style=\"color:#EF4444\">⚠️ CV no generado</p>')\n        + '<br><br><hr style=\"border:none;border-top:1px solid #ddd;margin:24px 0\">'\n        + '<h3 style=\"color:#1F5C8B\">📧 Contacto en la empresa</h3>'\n        + (nombreContacto ? '<p><strong>Nombre:</strong> ' + nombreContacto + '</p>' : '')\n        + (emailContacto ? '<p><strong>Email:</strong> ' + emailContacto + '</p>' : '')\n        + (telefonoContacto ? '<p><strong>Teléfono:</strong> ' + telefonoContacto + '</p>' : '')\n        + '<br><a href=\"https://n8n-st1v.onrender.com/webhook/@@SECRET:Webhook Mandar Empresa?id=' + pageId + '\" style=\"background:#22C55E;color:white;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;font-weight:bold\">✅ Confirmar envío a empresa</a>'\n        + '</div>',\n      trackClicks: false, trackOpens: false\n    })\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        720
