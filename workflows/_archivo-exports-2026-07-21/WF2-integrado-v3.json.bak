              "key": "Estado|select",
              "selectValue": "=Pendiente"
            },
            {
              "key": "Nombre Contacto|rich_text",
              "textContent": "={{ $json.nombre_contacto || '' }}"
            },
            {
              "key": "Email empresa|email",
              "emailValue": "={{ $json.email_contacto && $json.email_contacto.includes('@') ? $json.email_contacto : null }}"
            },
            {
              "key": "Fecha Publicacion|date",
              "date": "={{ $json.fecha_publicacion || null }}"
            },
            {
              "key": "Usuario|relation",
              "relationValue": "={{ $json.user_id ? [$json.user_id] : [] }}"
            },
            {
              "key": "Email Enviado|email",
              "emailValue": "={{ $('Code - Normalizar Modalidad').item.json.email_usuario || '' }}"
            }
          ]
        },
        "options": {}
      },
