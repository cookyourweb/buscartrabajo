        "jsCode": "const correos = $input.all().map(item => {\n  const j = item.json;\n  return `- De: ${j.from} | Asunto: ${j.subject}\\n  ${(j.bodyPreview || '').slice(0, 200)}`;\n}).join('\\n\\n');\n\nreturn [{ json: { correos } }];"
